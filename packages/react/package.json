{
  "name": "@tx404/react",
  "version": "0.1.0",
  "description": "React provider and hooks for the Tx404 STRK20 SDK",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
